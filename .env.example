# No API key or billing account is needed. Override these endpoints if using
# your own compatible services. Restart after changing settings.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_URL=http://127.0.0.1:5001
OVERPASS_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass-api.de/api/interpreter
# Default: reuse/download regional PBFs and search locally, without public query waits.
# Optional legacy live-query mode: DISCOVERY_SOURCE=overpass
DISCOVERY_SOURCE=local
# Optional absolute directory. Defaults to this application's data/.
# PLANNER_DATA_DIR=/absolute/private/path

# Automatically download/preprocess missing regional road data (CPU, disk, network).
OSRM_AUTO_DOWNLOAD=1
# Optional known Geofabrik ID for an existing fixed backend; blank probes points.
OSRM_BASE_REGION=
# Optional native profile path; auto-detected on Homebrew and in Docker.
# OSRM_CAR_PROFILE=/absolute/path/to/car.lua
# Optional official Google Embed API. Default keyless Google iframes need no account.
# GOOGLE_MAPS_EMBED_KEY=
# Resource guard: maximum individual extract download, MB; 0 removes the ceiling.
# Raise only on a host with adequate RAM/disk for preprocessing.
OSRM_MAX_EXTRACT_MB=2048
